{
  "name": "frontend-orchestration-platform",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "libs/mfe-communication",
    "mfes/*"
  ],
  "scripts": {
    "nx": "nx",
    "postinstall": "npm run build -w @stavgian/mfe-communication",
    "build": "nx run-many --target=build --all",
    "build:github-pages": "node scripts/build-github-pages.mjs",
    "build:cloudflare": "PAGES_BASE_PATH=/ node scripts/build-github-pages.mjs",
    "build:mfe-communication": "nx run mfe-communication:build",
    "test:mfe-communication": "nx run mfe-communication:test",
    "build:angular-mfe": "npm run build -w angular-mfe",
    "build:react-mfe": "npm run build -w react-mfe",
    "build:js-mfe": "npm run build -w js-mfe",
    "build:vue-mfe": "npm run build -w vue-mfe",
    "serve:all": "npm run build:mfe-communication && concurrently -k -n ANG,REACT,JS,VUE,PORTAL -c cyan,magenta,yellow,blue,green \"npm:serve:angular-mfe\" \"npm:serve:react-mfe\" \"npm:serve:js-mfe\" \"npm:serve:vue-mfe\" \"NX_DAEMON=false npm run serve:portal\"",
    "serve:portal": "nx serve portal",
    "serve:angular-mfe": "npm run serve -w angular-mfe",
    "serve:react-mfe": "npm run serve -w react-mfe",
    "serve:js-mfe": "npm run serve -w js-mfe",
    "serve:vue-mfe": "npm run serve -w vue-mfe"
  },
  "dependencies": {
    "@angular/animations": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/elements": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-browser-dynamic": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@stavgian/mfe-communication": "^2.0.0",
    "esbuild": "^0.21.5",
    "rxjs": "~7.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.2.0",
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular-eslint/eslint-plugin": "22.7.0",
    "@angular-eslint/eslint-plugin-template": "22.7.0",
    "@angular-eslint/template-parser": "22.7.0",
    "@angular/compiler-cli": "~22.2.0",
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.6",
    "@nx/devkit": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/jest": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/playwright": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@types/jest": "30.0.0",
    "@types/node": "^20.11.25",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript-eslint/utils": "8.73.0",
    "angular-eslint": "^22.0.0",
    "concurrently": "^9.2.1",
    "eslint": "9.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.0.5",
    "jest-preset-angular": "17.0.3",
    "jest-util": "30.0.5",
    "nx": "24.0.6",
    "playwright": "^1.41.2",
    "prettier": "^2.8.8",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.1",
    "tslib": "^2.6.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^5.0.12"
  }
}
