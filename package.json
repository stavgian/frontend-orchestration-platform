{
  "name": "frontend-orchestration-platform",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "libs/mfe-communication",
    "mfes/*"
  ],
  "scripts": {
    "nx": "nx",
    "postinstall": "npm run build -w @stavgian/mfe-communication",
    "build": "nx run-many --target=build --all",
    "build:github-pages": "node scripts/build-github-pages.mjs",
    "build:mfe-communication": "nx run mfe-communication:build",
    "test:mfe-communication": "nx run mfe-communication:test",
    "build:angular-mfe": "npm run build -w angular-mfe",
    "build:react-mfe": "npm run build -w react-mfe",
    "build:js-mfe": "npm run build -w js-mfe",
    "serve:all": "npm run build:mfe-communication && concurrently -k -n ANG,REACT,JS,PORTAL -c cyan,magenta,yellow,green \"npm:serve:angular-mfe\" \"npm:serve:react-mfe\" \"npm:serve:js-mfe\" \"NX_DAEMON=false npm run serve:portal\"",
    "serve:portal": "nx serve portal",
    "serve:angular-mfe": "npm run serve -w angular-mfe",
    "serve:react-mfe": "npm run serve -w react-mfe",
    "serve:js-mfe": "npm run serve -w js-mfe",
    "serve:mfe-a": "nx serve mfe-a",
    "serve:mfe-b": "nx serve mfe-b",
    "build:mfe-a": "nx build mfe-a",
    "build:mfe-b": "nx build mfe-b"
  },
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/elements": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "@stavgian/mfe-communication": "^1.0.0",
    "esbuild": "^0.21.5",
    "rxjs": "~7.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "18.2.14",
    "@angular-devkit/core": "18.2.14",
    "@angular-devkit/schematics": "18.2.14",
    "@angular-eslint/eslint-plugin": "^18.0.1",
    "@angular-eslint/eslint-plugin-template": "^18.0.1",
    "@angular-eslint/template-parser": "^18.0.1",
    "@angular/compiler-cli": "^18.2.14",
    "@nx/angular": "19.2.3",
    "@nx/devkit": "19.2.3",
    "@nx/eslint": "19.2.3",
    "@nx/eslint-plugin": "19.2.3",
    "@nx/jest": "^19.2.3",
    "@nx/js": "19.2.3",
    "@nx/playwright": "^19.2.3",
    "@nx/vite": "19.2.3",
    "@nx/web": "19.2.3",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "18.2.14",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^29.4.0",
    "@types/node": "^20.11.25",
    "@typescript-eslint/eslint-plugin": "^7.3.0",
    "@typescript-eslint/parser": "^7.3.0",
    "@typescript-eslint/utils": "^8.0.0-alpha.28",
    "concurrently": "^9.2.1",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-playwright": "^0.15.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "~14.1.0",
    "nx": "19.2.3",
    "playwright": "^1.41.2",
    "prettier": "^2.8.8",
    "ts-jest": "^29.2.5",
    "ts-node": "10.9.1",
    "tslib": "^2.6.2",
    "typescript": "~5.4.5",
    "vite": "^5.0.12"
  }
}
