  "apps": [
    {
      "id": "angular-mfe",
      "department": "Legal Department",
      "responsibility": "Case status and overview",
      "contextTypes": [
        "legal-case"
      ]
    },
    {
      "id": "react-mfe",
      "department": "Document Management",
      "responsibility": "Contracts and evidence",
      "contextTypes": [
        "legal-case"
      ]
    },
    {
      "id": "js-mfe",
      "department": "Compliance Department",
      "responsibility": "Checks and validations",
      "contextTypes": [
        "legal-case"
      ]
    },
    {
      "id": "vue-mfe",
      "department": "Finance Department",
      "responsibility": "Time entries and billing",
      "contextTypes": [
        "legal-case"
      ]
    },
    {
      "id": "svelte-mfe",
      "department": "Client Services",
      "responsibility": "Communication history",
      "contextTypes": [
        "legal-case"
      ]
    },
    {
      "id": "lit-mfe",
      "department": "Risk Management",
      "responsibility": "Risk assessment and exposure",
      "contextTypes": [
        "legal-case"
      ]
    }
  ],
  "exampleEvents": [
    {
      "type": "document:uploaded",
      "publisher": "react-mfe",
      "consumers": [
        "js-mfe",
        "lit-mfe",
        "svelte-mfe"
      ],
      "description": "A document was added. Compliance re-checks, Risk re-scores, Client Relations logs it."
    },
    {
      "type": "compliance:check:completed",
      "publisher": "js-mfe",
      "consumers": [
        "angular-mfe"
      ],
      "description": "A compliance check finished. Legal shows the outcome."
    },
    {
      "type": "billing:updated",
      "publisher": "vue-mfe",
      "consumers": [
        "lit-mfe",
        "svelte-mfe"
      ],
      "description": "Time was billed. Risk adjusts exposure, Client Relations logs it."
    },
    {
      "type": "risk:assessment:updated",
      "publisher": "lit-mfe",
      "consumers": [
        "angular-mfe"
      ],
      "description": "The risk score changed. Legal shows it."
    }
  ],
  "useCase": [
    "A law firm handles multiple client cases, with different departments contributing to each one. Legal manages case progress, Document Management handles contracts and evidence, Finance oversees billing, Compliance performs checks, Client Services manages client communication and Risk evaluates potential exposure.",
    "This demonstration brings all six departments together in one workspace. Each department operates its own independent application, but all applications work with the same case. When a document is added, for example, Compliance can initiate a new check and Risk can update its assessment. All information is fictional."
  ]
}
