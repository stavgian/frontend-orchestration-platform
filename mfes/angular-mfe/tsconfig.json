{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": ".aot",
    "types": []
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "files": ["src/main.ts"]
}
